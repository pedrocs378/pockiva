{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pockiva",
  "version": "0.1.2",
  "identifier": "com.pedro.pockiva",
  "build": {
    "beforeDevCommand": "pnpm --filter @gameboy/remote-controller build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @gameboy/remote-controller build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pockiva",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../remote-controller/dist/": "controller"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGQjI1QzQ3QjY1QThDMTMKUldRVGpGcTJSMXl5bnlZMUxGNERTdUhvaFYzTVYyRCtmUUxaM21QVURhSVByZWZwTHRjUk5mcHkK",
      "endpoints": ["https://github.com/pedrocs378/pockiva/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
